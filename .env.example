# Required for a public deployment
NODE_ENV=production
PORT=8787

# Slot payments: one paid slot buys one room, guests join free with the code.
# Production defaults to gated; set REQUIRE_SLOT_PAYMENT=0 for free hosting.
REQUIRE_SLOT_PAYMENT=1
SLOT_PRICE=25000
CURRENCY=IDR
MERCHANT_NAME=Photovirtu
ORDER_TTL_MS=604800000
MAX_PROOF_BYTES=1200000
MAX_QRIS_BYTES=512000

SLOT_DB_PATH=./server/data/photovirtu.sqlite
ADMIN_PASSWORD=replace-with-a-long-random-password
ALLOWED_ORIGINS=https://photo.example.com

# Set to 1 only when direct origin access is blocked and exactly one trusted
# reverse proxy sits in front of Node.
TRUST_PROXY=0

# Optional when API and WebSocket use different public origins.
# VITE_API_BASE=https://api.example.com
# VITE_ROOM_SERVER=wss://api.example.com/ws
